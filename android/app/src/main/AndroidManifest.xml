<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Core networking -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- VPN transport -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- v0.6.0 §in-app-update: download + install the update APK inside the
         app (DownloadManager streams it; the system installer asks for the
         user's one-tap consent — REQUEST_INSTALL_PACKAGES declares it). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>

    <application
        android:label="Atlanhix"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true">
        <!-- v0.6.0 §in-app-update: shares the downloaded update APK with the
             system installer without making the app dir world-readable. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.atlanhix.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deeplink import: Atlanhix://import?url=... (docs/PROTOCOL_SUPPORT.md) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="Atlanhix" android:host="import"/>
            </intent-filter>
        </activity>
        <!-- VPN foreground service (wired via platform channel; see
             docs/PLATFORM_ARCHITECTURE.md â€” Android section). -->
        <!-- v0.4.3: Xray core runs in its OWN process (:xray) — a second Go
             runtime must never share the main process with libbox, and the
             exec'd libxray_core.so lives in the native lib dir (allowed by
             Android W^X; requires extractNativeLibs below). Same UID as the
             VPN owner ⇒ its own egress bypasses the TUN (VpnInfo
             protectedUsers), so the socks-upstream chain cannot loop. -->
        <service
            android:name=".vpn.XrayCoreService"
            android:process=":xray"
            android:foregroundServiceType="specialUse"
            android:exported="false" />
        <!-- v0.5.3: mihomo (Clash.Meta) core — same child-process topology
             as :xray (its own Go runtime, own :mihomo process). -->
        <service
            android:name=".vpn.MihomoCoreService"
            android:process=":mihomo"
            android:foregroundServiceType="specialUse"
            android:exported="false" />
        <service
            android:name=".vpn.AtlanhixVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_tunnel"/>
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

