.dart_tool/
.packages
build/
*.iml
.idea/
.vscode/
android/.gradle/
android/local.properties
windows/flutter/ephemeral/
linux/flutter/ephemeral/
*.log

# v0.5.2 §repo-hygiene — ad-hoc capture files from build/install/debug
# sessions never belong in the repo (they were littering git status as
# untracked: build_apk_log.txt, build_log_atx*.txt, inst*.txt,
# install_out.txt, atx_ui_dump.txt). Catch ALL of them by pattern so the
# next debug session stays clean.
/android/build_*.txt
/android/inst*.txt
/android/install_out.txt
/atx_*_dump.txt
/atx_*.log

# One-off secret/ops scripts live outside the repo — the token must never
# be near a tracked file (set_secrets.js was the last offender; it reads
# GH_TOKEN from the env, so a future copy belongs in a private location).
/set_secrets.js

# APK split scratch dir used during manual install debugging.
/chunks/

# Engine binaries are user/builder-provided (see BUILD.md) — never committed.
cores/

# v0.5.6 repo-hygiene: GENERATED planet-shader preview artifacts. Both are
# build outputs of the tracked scripts in this directory and far too big to
# version (planet_preview.html ~700 kB self-contained WebGL2 bundle;
# land_mask.json ~700 kB base64 pixel dump). Regenerate with:
#   node tools/bake_land_mask.js        (writes land_mask.json)
#   node tools/build_planet_preview.js  (writes planet_preview.html)
/tools/planet_preview.html
/tools/land_mask.json
